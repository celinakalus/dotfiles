{
	"exclusive": false,
	"position": "bottom",

	"modules-left": ["clock", "network", "bluetooth", "custom/keyboard", "custom/screencap"],
	"modules-center": ["sway/workspaces", "sway/mode"],
	"modules-right": ["tray", "cpu", "memory", "battery", "custom/power"],

	"sway/mode": {
		"format": "<span style=\"italic\">{}</span>"
	},
	"battery": {
		"format-time": "{H}:{m}",
		"format": "{icon} {capacity}%",
		"format-discharging": "{icon} {power}W {capacity}% ({time})",
		"format-charging": "{icon}󱐋 {capacity}% ({time})",
		"format-icons": [" ", " ", " "]
	},
	"memory": {
		"format": "  {percentage}%",
	},
	"cpu": {
		"format": "  {usage}%",
	},
	"network": {
		"format-wifi": "  {essid} ({signalStrength}%)",
		"format-ethernet": "  {ifname}",
		"format-disconnected": " ", 
		"max-length": 50,
	},
	"bluetooth": {
		"format": "󰂲 ",
		"format-connected": " {device_alias}",
		"on-click": "alacritty --class launcher -e bluetoothctl"
	},
	"tray": {
		"icon-size": 15,
		"spacing": 10
	},
	"clock": {
		"format": "󰥔 {:%H:%M [%Y-%m-%d KW%V]}",
		"on-click": "gnome-calendar"
	},
	"custom/power": {
		"format": " ",
		"on-click": "swaynag -t warning -m 'Power Menu Options' -b 'Logout' 'swaymsg exit' -b 'Restart' 'shutdown -r now' -b 'Shutdown'  'shutdown -h now' --background=#005566 --button-background=#009999 --button-border=#002b33 --border-bottom=#002b33"
	},
	"custom/keyboard": {
		"format": "⌨ ",
		"on-click": "pkill -SIGRTMIN wvkbd-mobintl"
	},
	"custom/screencap": {
		"format": "📷 ",
		"on-click": "bash -c \"grim -g '$(slurp)' - | wl-copy\""
	},
}
